#!/usr/bin/env bash
# Roda um comando no container de desenvolvimento.
#
# Delegar para `docker compose run` é de propósito: assim o comando roda na
# mesma rede dos serviços e enxerga o mesmo banco. Um `docker run` avulso com
# host.docker.internal alcança o Postgres do WSL na máquina, que é outra base
# e está numa versão de schema diferente — e a falha aparece como "migration
# pendente", que é um sintoma enganoso.
#
# O bundle fica num volume nomeado, então as extensões nativas compilam uma vez.
#
# Uso:
#   bin/docker-dev rspec                     # ambiente de desenvolvimento
#   RAILS_ENV=test bin/docker-dev rspec      # contra o banco de teste
#   bin/docker-dev rails db:migrate
#   bin/docker-dev sh -c "bundle exec rails server -u agoo"
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -eq 0 ]; then
  echo "uso: bin/docker-dev <comando> [args...]" >&2
  echo "exemplos:" >&2
  echo "  bin/docker-dev rspec" >&2
  echo "  RAILS_ENV=test bin/docker-dev rspec" >&2
  echo "  bin/docker-dev rails db:migrate" >&2
  exit 64
fi

# O /usr/bin/docker do WSL sombreia o do Docker Desktop e sempre falha, porque o
# Desktop não expõe socket unix. Escolhe o cliente que fala com o daemon.
DOCKER=""
for candidate in docker.exe docker; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" info >/dev/null 2>&1; then
    DOCKER="$candidate"
    break
  fi
done

if [ -z "$DOCKER" ]; then
  echo "não achei um cliente docker que fale com o daemon. O Docker Desktop está aberto?" >&2
  exit 69
fi

# Os binstubs (bin/rspec, bin/rubocop) só existem depois do bundle install, e a
# imagem não os cria. Wrappe em bundle exec para que `docker-dev rspec` funcione
# igual `bin/rspec` na máquina.
case "$1" in
  bundle|ruby|sh|bash|-* ) ;;
  rspec|rubocop|rails|rake|brakeman|bundler-audit|thrust|kamal)
    set -- bundle exec "$@" ;;
esac

# db:migrate e db:seed são idempotentes, mas não fazem sentido a cada comando.
# Quem quiser rodá-los pede explicitamente, ou sobe com `docker compose up`.
#
# RAILS_ENV precisa decidir antes de montar o docker run, e não pode depender
# de quem chamou. Variável de ambiente do PowerShell não chega no WSL bash, então
# `RAILS_ENV=test` digitado no PowerShell chegaria vazio aqui e cairia em
# development — que é exatamente o bug que este script corrige.
#
# Por isso a regra é por comando, não por ambiente: rodar spec é sempre test,
# sem depender de nada externo. Os outros comandos seguem o ambiente, com
# development como padrão.
case "$1" in
  rspec) RAILS_ENV_VALUE=test ;;
  *) RAILS_ENV_VALUE="${RAILS_ENV:-development}" ;;
esac

"$DOCKER" compose run --rm \
  -e RUN_MIGRATIONS=0 \
  -e RAILS_ENV="$RAILS_ENV_VALUE" \
  --entrypoint /rails/docker/entrypoint-dev.sh \
  web "$@"
