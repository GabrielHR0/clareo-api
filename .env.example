# PostgreSQL
DATABASE_USERNAME=teste
DATABASE_PASSWORD=sua_senha_aqui
DATABASE_HOST=127.0.0.1
# Cluster do WSL, gerenciado por systemd.
DATABASE_PORT=5432
DATABASE_NAME=clareo_development
DATABASE_NAME_TEST=clareo_test

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Rails
RAILS_ENV=development
SECRET_KEY_BASE= gere_com_rails_secret

# JWT
JWT_SECRET=minimo_32_bytes_aleatorios
JWT_EXPIRATION=86400

# Asaas
# O provedor só existe em Linux/macOS. O ambiente é explícito de propósito:
# inferir a partir da API key é como se usa chave de sandbox em produção.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_URL_SANDBOX=https://api-sandbox.asaas.com/v3
ASAAS_URL_PRODUCTION=https://api.asaas.com/v3
ASAAS_WEBHOOK_URL=
# 32-255 caracteres. NÃO pode ser uma API key do Asaas.
ASAAS_WEBHOOK_TOKEN=

# App
FRONTEND_URL=http://localhost:3001