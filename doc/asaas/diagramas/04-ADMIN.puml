@startuml Clareo - Admin
!theme plain
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam packageFontSize 14
skinparam usecaseFontSize 12
skinparam defaultFontName Arial

title Clareo — Diagrama de Casos de Uso: Admin

actor "Admin" as Admin
actor "Asaas\n(PSP)" as Asaas

rectangle "Sistema Clareo" {
  usecase "Fazer Login" as UC1
  usecase "Gerenciar Instituições" as UC2
  usecase "Cadastrar Instituição" as UC3
  usecase "Editar Instituição" as UC4
  usecase "Aprovar Instituição" as UC5
  usecase "Desativar Instituição" as UC6
  usecase "Gerenciar Usuários" as UC7
  usecase "Listar Usuários" as UC8
  usecase "Editar Usuário" as UC9
  usecase "Desativar Usuário" as UC10
  usecase "Ver Relatórios" as UC11
  usecase "Relatório de Doações" as UC12
  usecase "Relatório de Splits" as UC13
  usecase "Relatório de Receita" as UC14
  usecase "Configurar Sistema" as UC15
  usecase "Definir Taxa\nComissão" as UC16
}

rectangle "Asaas (PSP)" {
  usecase "Criar Subconta\nInstituição" as UC_A1
  usecase "Consultar\nTransações" as UC_A2
}

Admin --> UC1
Admin --> UC2
Admin --> UC7
Admin --> UC11
Admin --> UC15

UC2 --> UC3
UC2 --> UC4
UC2 --> UC5
UC2 --> UC6

UC7 --> UC8
UC7 --> UC9
UC7 --> UC10

UC11 --> UC12
UC11 --> UC13
UC11 --> UC14

UC15 --> UC16

UC3 ..> UC_A1 : include

note right of UC5
  Ao aprovar, Clareo
  cria subconta no
  Asaas para a
  instituição.
end note

note bottom of UC_A1
  Subconta permite
  que instituição
  receba splits
  automaticamente.
end note

@enduml
