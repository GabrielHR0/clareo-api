@startuml Clareo - Relatorios
!theme plain
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam packageFontSize 14
skinparam usecaseFontSize 12
skinparam defaultFontName Arial

title Clareo — Diagrama de Casos de Uso: Relatórios

actor "Instituição" as Institution

rectangle "Sistema Clareo" {
  usecase "Gerar Relatório\nPDF" as UC1
  usecase "Gerar Relatório\nCSV" as UC2
  usecase "Definir Período" as UC3
  usecase "Ver Resumo\nFinanceiro" as UC4
  usecase "Ver Total\nDoações" as UC5
  usecase "Ver Média\nDoação" as UC6
  usecase "Ver Top Doadores" as UC7
  usecase "Ver Evolução\nMensal" as UC8
  usecase "Baixar Relatório" as UC9
  usecase "Listar Relatórios\nAnteriores" as UC10
}

rectangle "Gerador de Relatórios" {
  usecase "Calcular Totais" as UC_G1
  usecase "Calcular Média" as UC_G2
  usecase "Gerar Gráfico" as UC_G3
  usecase "Gerar Arquivo" as UC_G4
}

rectangle "Storage" {
  usecase "Armazenar\nRelatório" as UC_S1
}

Institution --> UC1
Institution --> UC2
Institution --> UC3
Institution --> UC4
Institution --> UC9
Institution --> UC10

UC1 ..> UC_G1 : include
UC1 ..> UC_G2 : include
UC1 ..> UC_G4 : include
UC2 ..> UC_G4 : include
UC4 ..> UC5 : inclui
UC4 ..> UC6 : inclui
UC4 ..> UC7 : inclui
UC4 ..> UC8 : inclui
UC_G4 ..> UC_S1 : salva
UC9 ..> UC_S1 : baixa

note right of UC1
  Requer assinatura
  Pro. Gera PDF
  com gráficos e
  tabelas.
end note

note bottom of UC4
  Dashboard com:
  - Total de doações
  - Valor total recebido
  - Média por doação
  - Top 10 doadores
  - Evolução mensal
end note

note right of UC7
  Lista os maiores
  doadores (sem
  dados sensíveis).
end note

@enduml
