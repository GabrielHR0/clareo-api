@startuml Clareo - Visao Geral
!theme plain
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam packageFontSize 14
skinparam usecaseFontSize 12
skinparam defaultFontName Arial

title Clareo — Diagrama de Casos de Uso (Visão Geral)

actor "Doador" as Donor
actor "Instituição" as Institution
actor "Admin" as Admin
actor "Asaas\n(PSP)" as Asaas

rectangle "Sistema Clareo" {
  usecase "Cadastrar Conta" as UC1
  usecase "Fazer Login" as UC2
  usecase "Doar via PIX" as UC3
  usecase "Ver Doações" as UC4
  usecase "Ver Status Doação" as UC5
  usecase "Receber Split" as UC6
  usecase "Gerenciar Instituições" as UC7
  usecase "Gerenciar Usuários" as UC8
  usecase "Ver Relatórios" as UC9
  usecase "Criar Subconta" as UC10
  usecase "Criar Cobrança\ncom Split" as UC11
  usecase "Processar Webhook" as UC12
}

Donor --> UC1
Donor --> UC2
Donor --> UC3
Donor --> UC4
Donor --> UC5

Institution --> UC1
Institution --> UC2
Institution --> UC6
Institution --> UC4

Admin --> UC2
Admin --> UC7
Admin --> UC8
Admin --> UC9

Asaas --> UC10
Asaas --> UC12

UC3 ..> UC11 : include
UC11 ..> UC10 : include
UC12 ..> UC6 : include

@enduml
