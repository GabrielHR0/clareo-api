@startuml Clareo - Visao Geral
!theme plain
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam packageFontSize 14
skinparam usecaseFontSize 12
skinparam defaultFontName Arial

title Clareo — Diagrama de Casos de Uso (Visão Geral)

actor "Visitante" as Visitor
actor "Doador" as Donor
actor "Instituição" as Institution
actor "Admin" as Admin
actor "Asaas\n(PSP)" as Asaas

rectangle "Sistema Clareo" {
  usecase "Cadastrar Conta" as UC1
  usecase "Fazer Login" as UC2
  usecase "Ver Campanhas" as UC3
  usecase "Ver Feed\nTransparência" as UC4
  usecase "Doar via PIX" as UC5
  usecase "Ver Doações" as UC6
  usecase "Criar Campanha" as UC7
  usecase "Postar Atualização" as UC8
  usecase "Gerar Relatório" as UC9
  usecase "Ver Saldo" as UC10
  usecase "Gerenciar Instituições" as UC11
  usecase "Gerenciar Usuários" as UC12
  usecase "Ver Relatórios\nAdmin" as UC13
  usecase "Criar Subconta" as UC14
  usecase "Criar Cobrança\ncom Split" as UC15
  usecase "Processar Webhook" as UC16
  usecase "Gerenciar\nAssinatura" as UC17
}

Visitor --> UC3
Visitor --> UC4

Donor --> UC1
Donor --> UC2
Donor --> UC5
Donor --> UC6

Institution --> UC1
Institution --> UC2
Institution --> UC6
Institution --> UC7
Institution --> UC8
Institution --> UC9
Institution --> UC10
Institution --> UC17

Admin --> UC2
Admin --> UC11
Admin --> UC12
Admin --> UC13

Asaas --> UC14
Asaas --> UC16

UC5 ..> UC15 : include
UC15 ..> UC14 : include
UC16 ..> UC6 : include

note right of UC7
  Requer assinatura
  Pro (paga).
end note

note bottom of UC8
  Feed público.
  Qualquer um vê.
end note

@enduml
