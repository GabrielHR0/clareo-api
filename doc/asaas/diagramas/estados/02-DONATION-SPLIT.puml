@startuml Estado - DonationSplit
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam stateFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam state {
  BackgroundColor<<active>> LightBlue
  BackgroundColor<<final>> LightGreen
  BackgroundColor<<error>> LightRed
  BorderColor DarkGray
  FontSize 12
}

title Estado: DonationSplit (Rateio)

[*] --> pending : Split criado

pending --> awaiting_credit : Asaas\nprocessando

awaiting_credit --> done : Webhook\nPAYMENT_SPLIT_DONE

awaiting_credit --> refused : Asaas\nrecusou split

awaiting_credit --> cancelled : Clareo\ncancelou

done --> refunded : Webhook\nPAYMENT_REFUNDED

done --> [*]
refused --> [*]
cancelled --> [*]
refunded --> [*]

state pending <<active>>
state awaiting_credit <<active>>
state done <<final>>
state refused <<error>>
state cancelled <<error>>
state refunded <<error>>

note right of pending
  Split aguardando
  processamento
  pelo Asaas.
end note

note right of awaiting_credit
  Asaas está
  processando a
  transferência.
end note

note bottom of done
  Split creditado
  na subconta
  da instituição.
  Estado final normal.
end note

note left of refused
  Asaas recusou
  o split (divergência,
  saldo insuficiente).
end note

note left of cancelled
  Clareo cancelou
  o split antes
  do processamento.
end note

@enduml
