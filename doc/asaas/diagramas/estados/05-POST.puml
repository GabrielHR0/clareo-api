@startuml Estado - Post
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam stateFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam state {
  BackgroundColor<<active>> LightBlue
  BackgroundColor<<final>> LightGreen
  BackgroundColor<<error>> LightRed
  BorderColor DarkGray
  FontSize 12
}

title Estado: Post (Publicação)

[*] --> published : Post criado\n(published_at = agora)

published --> [*] : Post visível\nno feed público

note right of published
  Post é público
  imediatamente.
  Visível no feed
  da instituição.
end note

state published <<active>>

@enduml
