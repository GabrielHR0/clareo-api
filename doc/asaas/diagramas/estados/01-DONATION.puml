@startuml Estado - Donation
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam stateFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam state {
  BackgroundColor<<active>> LightBlue
  BackgroundColor<<final>> LightGreen
  BackgroundColor<<error>> LightRed
  BorderColor DarkGray
  FontSize 12
}

title Estado: Donation (Doação)

[*] --> pending : Doação criada

pending --> received : Webhook\nPAYMENT_RECEIVED
pending --> failed : Webhook\nPAYMENT_OVERDUE
pending --> failed : Webhook\nPAYMENT_DELETED

received --> split_done : Webhook\nPAYMENT_SPLIT_DONE
received --> failed : Webhook\nPAYMENT_SPLIT_DIVERGENCE_BLOCK

split_done --> [*]

failed --> [*]

pending --> refunded : Webhook\nPAYMENT_REFUNDED
received --> refunded : Webhook\nPAYMENT_REFUNDED
split_done --> refunded : Webhook\nPAYMENT_REFUNDED

refunded --> [*]

state pending <<active>>
state received <<active>>
state split_done <<final>>
state failed <<error>>
state refunded <<error>>

note right of pending
  PIX aguardando
  pagamento do doador.
end note

note right of received
  PIX recebido,
  aguardando processamento
  do split.
end note

note bottom of split_done
  Split concluído.
  Instituições creditadas.
  Estado final normal.
end note

note left of failed
  Pagamento falhou,
  expirou ou foi cancelado.
end note

@enduml
