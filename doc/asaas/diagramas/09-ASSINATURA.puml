@startuml Clareo - Assinatura
!theme plain
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam packageFontSize 14
skinparam usecaseFontSize 12
skinparam defaultFontName Arial

title Clareo — Diagrama de Casos de Uso: Assinatura

actor "Instituição" as Institution
actor "Asaas\n(PSP)" as Asaas

rectangle "Sistema Clareo" {
  usecase "Ver Plano Atual" as UC1
  usecase "Ver Funcionalidades\nDisponíveis" as UC2
  usecase "Fazer Upgrade\npara Pro" as UC3
  usecase "Cancelar\nAssinatura" as UC4
  usecase "Ver Faturas" as UC5
  usecase "Ver Status\nAssinatura" as UC6
  usecase "Reativar\nAssinatura" as UC7
}

rectangle "Asaas (PSP)" {
  usecase "Criar Assinatura\nRecorrente" as UC_A1
  usecase "Gerar Boleto\nPIX Mensal" as UC_A2
  usecase "Webhook\nSUBSCRIPTION" as UC_A3
  usecase "Cancelar\nAssinatura Asaas" as UC_A4
}

Institution --> UC1
Institution --> UC2
Institution --> UC3
Institution --> UC4
Institution --> UC5
Institution --> UC6
Institution --> UC7

UC3 ..> UC_A1 : include
UC3 ..> UC_A2 : include
UC_A3 --> UC6 : atualiza
UC4 ..> UC_A4 : include
UC7 ..> UC_A1 : recria

note right of UC1
  Plano gratuito:
  Receber splits,
  ver doações.

  Plano Pro:
  + Campanhas
  + Transparência
  + Relatórios
  + Saldo
end note

note bottom of UC_A1
  Assinatura recorrente
  mensal. Asaas gera
  cobrança automatica
  todo mês.
end note

note right of UC5
  Lista todas as
  faturas pagas
  e pendentes.
  Inclui link
  para pagamento.
end note

@enduml
