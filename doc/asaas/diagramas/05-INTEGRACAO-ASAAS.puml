@startuml Clareo - Integracao Asaas
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Integração Asaas

left to right direction

' ===== Atores =====
actor "Doador" as Donor
actor "Instituição" as Institution
actor "Admin" as Admin

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Cobrança" {
    usecase "Criar Cobrança com Split" as UC1
    usecase "Gerar PIX Dinâmico" as UC2
    usecase "Consultar Status Pagamento" as UC3
  }

  package "Split" {
    usecase "Registrar Doação" as UC4
    usecase "Atualizar Status Split" as UC5
    usecase "Notificar Instituição" as UC6
  }

  package "Assinatura" {
    usecase "Criar Assinatura Pro" as UC7
    usecase "Atualizar Subscription" as UC8
  }

  package "Webhooks" {
    usecase "Receber Webhook\nPAYMENT_RECEIVED" as UC9
    usecase "Receber Webhook\nPAYMENT_SPLIT_DONE" as UC10
    usecase "Receber Webhook\nSUBSCRIPTION_CREATED" as UC11
  }

  package "Subcontas" {
    usecase "Criar Subconta\nInstituição" as UC12
  }
}

' ===== Asaas =====
rectangle "Asaas API" {
  usecase "POST /payments" as UC_A1
  usecase "PIX Dinâmico" as UC_A2
  usecase "Split Automático" as UC_A3
  usecase "POST /subaccounts" as UC_A4
  usecase "POST /subscriptions" as UC_A5
  usecase "GET /payments/{id}" as UC_A6
}

' ===== Banco Central =====
rectangle "Banco Central (PIX)" {
  usecase "Transferência Instantânea" as UC_B1
}

' ===== Conexões =====
Admin --> UC12
Donor --> UC1
Donor --> UC2
Institution --> UC3
Institution --> UC7

' ===== Relacionamentos =====
UC1 ..> UC_A1 : <<include>>
UC2 ..> UC_A2 : <<include>>
UC_A1 ..> UC_A3 : executa
UC12 ..> UC_A4 : <<include>>
UC7 ..> UC_A5 : <<include>>
UC3 ..> UC_A6 : consulta

UC9 --> UC4 : processa
UC10 --> UC5 : processa
UC11 --> UC8 : processa
UC5 ..> UC6 : after
UC_A3 ..> UC_B1 : executa

@enduml
