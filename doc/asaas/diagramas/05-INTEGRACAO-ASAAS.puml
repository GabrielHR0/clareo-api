@startuml Clareo - Integracao Asaas
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Integração Asaas

left to right direction

' ===== Atores =====
actor "Doador" as Donor
actor "Instituição" as Institution
actor "Admin" as Admin
actor "Asaas" as Asaas

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Cobrança" {
    usecase "Criar Cobrança com Split" as UC1
    usecase "Gerar PIX Dinâmico" as UC2
    usecase "Consultar Status" as UC3
  }

  package "Split" {
    usecase "Registrar Doação" as UC4
    usecase "Atualizar Status Split" as UC5
    usecase "Notificar Instituição" as UC6
  }

  package "Assinatura" {
    usecase "Criar Assinatura Pro" as UC7
    usecase "Atualizar Subscription" as UC8
  }

  package "Webhooks" {
    usecase "Receber Webhook" as UC9
  }

  package "Subcontas" {
    usecase "Criar Subconta" as UC10
  }
}

' ===== Conexões =====
Admin --> UC10
Donor --> UC1
Donor --> UC2
Institution --> UC3
Institution --> UC7

Asaas --> UC9

' ===== Relacionamentos =====
UC1 ..> Asaas : envia pagamento
UC2 ..> Asaas : gera QR
UC10 ..> Asaas : cria subconta
UC7 ..> Asaas : cria assinatura
UC9 ..> UC4 : processa
UC9 ..> UC5 : processa
UC9 ..> UC8 : processa
UC5 ..> UC6 : after
UC3 ..> Asaas : consulta

@enduml
