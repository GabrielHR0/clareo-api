@startuml Clareo - Transparencia
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Transparência

left to right direction

' ===== Atores =====
actor "Instituição" as Institution
actor "Doador" as Donor
actor "Visitante" as Visitor

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Gerenciar Posts (Pro)" {
    usecase "Criar Post" as UC1
    usecase "Editar Post" as UC2
    usecase "Excluir Post" as UC3
    usecase "Upload Comprovante" as UC4
  }

  package "Feed Público" {
    usecase "Ver Feed" as UC5
    usecase "Ver Detalhes Post" as UC6
    usecase "Ver Posts por Instituição" as UC7
    usecase "Filtrar por Tipo" as UC8
  }
}

' ===== Storage =====
rectangle "Storage" {
  usecase "Armazenar Arquivos" as UC_S1
}

' ===== Conexões =====
Institution --> UC1
Institution --> UC2
Institution --> UC3
Institution --> UC4

Visitor --> UC5
Visitor --> UC6
Visitor --> UC7
Visitor --> UC8

Donor --> UC5
Donor --> UC6
Donor --> UC7

' ===== Relacionamentos =====
UC4 ..> UC_S1 : envia
UC5 ..> UC1 : inclui
UC5 ..> UC4 : inclui

@enduml
