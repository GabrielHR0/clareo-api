@startuml Clareo - Doador
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Doador

left to right direction

' ===== Atores =====
actor "Doador" as Donor
actor "Asaas" as Asaas

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Conta" {
    usecase "Cadastrar Conta" as UC1
    usecase "Fazer Login" as UC2
    usecase "Esqueci a Senha" as UC3
    usecase "Editar Perfil" as UC4
  }

  package "Explorar" {
    usecase "Listar Instituições" as UC5
    usecase "Selecionar Instituição" as UC6
    usecase "Ver Campanhas Ativas" as UC7
    usecase "Ver Feed Transparência" as UC8
  }

  package "Doar" {
    usecase "Definir Valor" as UC9
    usecase "Gerar QR Code PIX" as UC10
    usecase "Pagar via PIX" as UC11
    usecase "Cancelar Doação" as UC12
  }

  package "Acompanhar" {
    usecase "Ver Status da Doação" as UC13
    usecase "Receber Confirmação" as UC14
    usecase "Ver Histórico de Doações" as UC15
  }
}

' ===== Asaas =====
rectangle "Asaas (PSP)" {
  usecase "Criar Cobrança com Split" as UC_A1
  usecase "Gerar PIX Dinâmico" as UC_A2
}

' ===== Conexões =====
Donor --> UC1
Donor --> UC2
Donor --> UC3
Donor --> UC4
Donor --> UC5
Donor --> UC6
Donor --> UC7
Donor --> UC8
Donor --> UC9
Donor --> UC11
Donor --> UC13
Donor --> UC15

' ===== Relacionamentos =====
UC6 ..> UC9 : lead para
UC10 ..> UC_A1 : <<include>>
UC_A1 ..> UC_A2 : <<include>>
UC11 ..> UC10 : utiliza
UC14 ..> UC13 : opcional
UC12 ..> UC13 : extends

@enduml
