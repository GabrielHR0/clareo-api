@startuml Diagrama de Classe - Clareo
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classAttributeFontSize 10
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam nodesep 40
skinparam ranksep 40

title Clareo — Diagrama de Classe do Sistema

' ===== Interfaces =====

interface "Autenticavel" as IAuth {
  + authenticate(email, password) : User
  + generate_token(user_id) : String
  + verify_token(token) : User
}

interface "Pagavel" as IPayable {
  + create_payment(params) : Payment
  + get_payment(id) : Payment
  + list_payments(filters) : Array
}

interface "Notificavel" as INotifiable {
  + send_webhook(event, data) : Boolean
  + verify_signature(signature, body) : Boolean
}

' ===== Classes de Modelo =====

class User {
  - id : Integer
  - name : String
  - email : String
  - password_digest : String
  - role : String
  --
  + institutions() : Array
  + donations() : Array
  + donor?() : Boolean
  + institution?() : Boolean
  + admin?() : Boolean
}

class Institution {
  - id : Integer
  - user_id : Integer
  - name : String
  - cnpj : String
  - description : String
  - pix_key : String
  - asaas_customer_id : String
  - asaas_wallet_id : String
  - active : Boolean
  --
  + user() : User
  + donation_splits() : Array
  + campaigns() : Array
  + posts() : Array
  + subscription() : Subscription
  + reports() : Array
  + active?() : Boolean
  + pro?() : Boolean
}

class Donation {
  - id : Integer
  - user_id : Integer
  - donor_name : String
  - donor_email : String
  - amount_brl : Decimal
  - fee_amount : Decimal
  - net_amount : Decimal
  - asaas_payment_id : String
  - status : String
  --
  + user() : User
  + donation_splits() : Array
  + pending?() : Boolean
  + received?() : Boolean
  + split_done?() : Boolean
  + failed?() : Boolean
}

class DonationSplit {
  - id : Integer
  - donation_id : Integer
  - institution_id : Integer
  - amount : Decimal
  - percentual : Decimal
  - asaas_split_id : String
  - status : String
  --
  + donation() : Donation
  + institution() : Institution
  + pending?() : Boolean
  + done?() : Boolean
  + refused?() : Boolean
}

class Campaign {
  - id : Integer
  - institution_id : Integer
  - title : String
  - description : String
  - goal_amount : Decimal
  - current_amount : Decimal
  - start_date : Date
  - end_date : Date
  - status : String
  --
  + institution() : Institution
  + donations() : Array
  + active?() : Boolean
  + paused?() : Boolean
  + closed?() : Boolean
  + progress_percent() : Float
  + pause()
  + resume()
  + close()
}

class Post {
  - id : Integer
  - institution_id : Integer
  - title : String
  - content : String
  - post_type : String
  - published_at : DateTime
  --
  + institution() : Institution
  + post_attachments() : Array
  + update?() : Boolean
  + receipt?() : Boolean
  + published?() : Boolean
}

class PostAttachment {
  - id : Integer
  - post_id : Integer
  - file_url : String
  - file_type : String
  - description : String
  --
  + post() : Post
  + pdf?() : Boolean
  + image?() : Boolean
}

class Subscription {
  - id : Integer
  - institution_id : Integer
  - plan : String
  - status : String
  - amount : Decimal
  - asaas_subscription_id : String
  - current_period_start : Date
  - current_period_end : Date
  --
  + institution() : Institution
  + free?() : Boolean
  + pro?() : Boolean
  + active?() : Boolean
  + can_create_campaigns?() : Boolean
  + can_post_updates?() : Boolean
}

class DonationReport {
  - id : Integer
  - institution_id : Integer
  - period_start : Date
  - period_end : Date
  - format : String
  - file_url : String
  - total_donations : Integer
  - total_amount : Decimal
  --
  + institution() : Institution
  + pdf?() : Boolean
  + csv?() : Boolean
}

' ===== Classes de Serviço =====

class AsaasService {
  - api_key : String
  - base_url : String
  --
  + create_customer(params) : Hash
  + create_subaccount(params) : Hash
  + create_payment(params) : Hash
  + get_payment(id) : Hash
  + create_subscription(params) : Hash
  + self.verify_webhook(request) : Boolean
}

class DonationService {
  + create(params) : Donation
  + confirm(asaas_payment_id) : Donation
  + calculate_splits(ids, amount) : Array
}

class CampaignService {
  + create(params, inst_id) : Campaign
  + update(id, params) : Campaign
  + pause(id) : Campaign
  + resume(id) : Campaign
  + close(id) : Campaign
}

class PostService {
  + create(params, inst_id) : Post
  + update(id, params) : Post
  + delete(id) : Boolean
  + add_attachment(post_id, file) : PostAttachment
}

class ReportService {
  + generate(params, inst_id) : DonationReport
  + calculate_stats(inst_id, period) : Hash
  + generate_file(report) : String
}

class SubscriptionService {
  + upgrade(inst_id) : Subscription
  + cancel(inst_id) : Subscription
  + confirm(sub_id) : Subscription
}

class WebhookService {
  + process(params) : Boolean
  + handle_payment_received(id) : Donation
  + handle_split_done(id) : Donation
  + handle_subscription_created(id) : Subscription
}

' ===== Relacionamentos =====

User "1" -- "0..*" Institution
User "1" -- "0..*" Donation

Institution "1" -- "1" Subscription
Institution "1" -- "0..*" DonationSplit
Institution "1" -- "0..*" Campaign
Institution "1" -- "0..*" Post
Institution "1" -- "0..*" DonationReport

Donation "1" -- "1..*" DonationSplit

Campaign "0..*" -- "0..*" Donation

Post "1" -- "0..*" PostAttachment

' ===== Dependências =====

AsaasService ..|> IPayable
AsaasService ..|> INotifiable
DonationService ..> AsaasService
CampaignService ..> AsaasService
SubscriptionService ..> AsaasService
WebhookService ..> AsaasService
WebhookService ..> DonationService
WebhookService ..> SubscriptionService
ReportService ..> Donation

@enduml
