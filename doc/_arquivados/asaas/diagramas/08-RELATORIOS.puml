@startuml Clareo - Relatorios
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Relatórios

left to right direction

' ===== Atores =====
actor "Instituição" as Institution

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Gerar Relatório (Pro)" {
    usecase "Definir Período" as UC1
    usecase "Selecionar Formato" as UC2
    usecase "Gerar Relatório PDF" as UC3
    usecase "Gerar Relatório CSV" as UC4
    usecase "Baixar Relatório" as UC5
  }

  package "Dashboard (Pro)" {
    usecase "Ver Resumo Financeiro" as UC6
    usecase "Ver Total Doações" as UC7
    usecase "Ver Média por Doação" as UC8
    usecase "Ver Top Doadores" as UC9
    usecase "Ver Evolução Mensal" as UC10
  }

  package "Histórico" {
    usecase "Listar Relatórios Anteriores" as UC11
  }
}

' ===== Gerador =====
rectangle "Motor de Relatórios" {
  usecase "Calcular Totais" as UC_G1
  usecase "Calcular Média" as UC_G2
  usecase "Gerar Gráfico" as UC_G3
  usecase "Montar Arquivo" as UC_G4
}

' ===== Storage =====
rectangle "Storage" {
  usecase "Armazenar Relatório" as UC_S1
}

' ===== Conexões =====
Institution --> UC1
Institution --> UC2
Institution --> UC3
Institution --> UC4
Institution --> UC5
Institution --> UC6
Institution --> UC11

' ===== Relacionamentos =====
UC3 ..> UC_G1 : <<include>>
UC3 ..> UC_G2 : <<include>>
UC4 ..> UC_G4 : <<include>>
UC3 ..> UC_G4 : <<include>>
UC_G4 ..> UC_S1 : salva
UC5 ..> UC_S1 : baixa
UC6 ..> UC7 : inclui
UC6 ..> UC8 : inclui
UC6 ..> UC9 : inclui
UC6 ..> UC10 : inclui

@enduml
