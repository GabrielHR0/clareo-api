@startuml Clareo - Instituicao
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Instituição

left to right direction

' ===== Atores =====
actor "Instituição" as Institution
actor "Asaas" as Asaas

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Conta" {
    usecase "Cadastrar Conta" as UC1
    usecase "Fazer Login" as UC2
    usecase "Editar Perfil" as UC3
  }

  package "Tier Gratuito" {
    usecase "Ver Doações Recebidas" as UC4
    usecase "Ver Extrato Básico" as UC5
    usecase "Solicitar Saque" as UC6
  }

  package "Campanhas (Pro)" {
    usecase "Criar Campanha" as UC7
    usecase "Gerenciar Campanha" as UC8
  }

  package "Transparência (Pro)" {
    usecase "Postar Atualização" as UC9
    usecase "Upload Comprovante" as UC10
  }

  package "Relatórios (Pro)" {
    usecase "Gerar Relatório" as UC11
    usecase "Ver Resumo Financeiro" as UC12
  }

  package "Financeiro (Pro)" {
    usecase "Ver Saldo Detalhado" as UC13
  }

  package "Assinatura" {
    usecase "Gerenciar Plano" as UC14
  }
}

' ===== Asaas =====
rectangle "Asaas (PSP)" {
  usecase "Receber Split" as UC_A1
  usecase "Transferir PIX" as UC_A2
  usecase "Criar Assinatura" as UC_A3
}

' ===== Conexões =====
Institution --> UC1
Institution --> UC2
Institution --> UC3
Institution --> UC4
Institution --> UC5
Institution --> UC6
Institution --> UC7
Institution --> UC8
Institution --> UC9
Institution --> UC10
Institution --> UC11
Institution --> UC12
Institution --> UC13
Institution --> UC14

' ===== Relacionamentos =====
UC_A1 --> UC4 : notifica
UC6 ..> UC_A2 : <<include>>
UC14 ..> UC_A3 : <<include>>

@enduml
