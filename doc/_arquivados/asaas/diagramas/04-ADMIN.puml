@startuml Clareo - Admin
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 13
skinparam packageStyle rectangle
skinparam useCaseFontSize 11
skinparam actorFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Clareo — Diagrama de Casos de Uso: Admin

left to right direction

' ===== Atores =====
actor "Admin" as Admin
actor "Asaas" as Asaas

' ===== Sistema =====
rectangle "Sistema Clareo" {

  package "Conta" {
    usecase "Fazer Login" as UC1
    usecase "Ver Perfil" as UC2
  }

  package "Gerenciar Instituições" {
    usecase "Cadastrar Instituição" as UC3
    usecase "Editar Instituição" as UC4
    usecase "Aprovar Instituição" as UC5
    usecase "Desativar Instituição" as UC6
    usecase "Listar Instituições" as UC7
  }

  package "Gerenciar Usuários" {
    usecase "Listar Usuários" as UC8
    usecase "Editar Usuário" as UC9
    usecase "Desativar Usuário" as UC10
  }

  package "Relatórios" {
    usecase "Ver Relatório de Doações" as UC11
    usecase "Ver Relatório de Splits" as UC12
    usecase "Ver Relatório de Receita" as UC13
  }

  package "Configurações" {
    usecase "Definir Taxa Comissão" as UC14
    usecase "Configurar Sistema" as UC15
  }
}

' ===== Asaas =====
rectangle "Asaas (PSP)" {
  usecase "Criar Subconta" as UC_A1
  usecase "Consultar Transações" as UC_A2
}

' ===== Conexões =====
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

' ===== Relacionamentos =====
UC5 ..> UC_A1 : <<include>>
UC11 ..> UC_A2 : consulta
UC12 ..> UC_A2 : consulta

@enduml
