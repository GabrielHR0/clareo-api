@startuml Clareo - Modelo Conceitual
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classAttributeFontSize 10
skinparam classFontSize 12
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50

title Clareo — Modelo Conceitual do Sistema

' ===== Classes =====

class User {
  id : Integer
  name : String
  email : String
  password_digest : String
  role : Enum
  created_at : DateTime
  updated_at : DateTime
}

class Institution {
  id : Integer
  name : String
  cnpj : String
  description : Text
  pix_key : String
  asaas_customer_id : String
  asaas_wallet_id : String
  active : Boolean
  created_at : DateTime
  updated_at : DateTime
}

class Donation {
  id : Integer
  donor_name : String
  donor_email : String
  amount_brl : Decimal
  fee_amount : Decimal
  net_amount : Decimal
  asaas_payment_id : String
  asaas_payment_url : String
  status : Enum
  metadata : JSON
  created_at : DateTime
  updated_at : DateTime
}

class DonationSplit {
  id : Integer
  amount : Decimal
  percentual : Decimal
  asaas_split_id : String
  status : Enum
  metadata : JSON
  created_at : DateTime
  updated_at : DateTime
}

class Campaign {
  id : Integer
  title : String
  description : Text
  goal_amount : Decimal
  current_amount : Decimal
  start_date : Date
  end_date : Date
  cover_image_url : String
  status : Enum
  created_at : DateTime
  updated_at : DateTime
}

class Post {
  id : Integer
  title : String
  content : Text
  post_type : Enum
  published_at : DateTime
  created_at : DateTime
  updated_at : DateTime
}

class PostAttachment {
  id : Integer
  file_url : String
  file_type : String
  description : String
  created_at : DateTime
  updated_at : DateTime
}

class Subscription {
  id : Integer
  plan : Enum
  status : Enum
  amount : Decimal
  asaas_subscription_id : String
  current_period_start : Date
  current_period_end : Date
  created_at : DateTime
  updated_at : DateTime
}

class DonationReport {
  id : Integer
  period_start : Date
  period_end : Date
  format : Enum
  file_url : String
  generated_at : DateTime
  total_donations : Decimal
  total_amount : Decimal
  average_donation : Decimal
  summary : JSON
  created_at : DateTime
  updated_at : DateTime
}

' ===== Relacionamentos =====

User "1" -- "0..*" Institution : possui
User "1" -- "0..*" Donation : realiza

Institution "1" -- "1" Subscription : possui
Institution "1" -- "0..*" DonationSplit : recebe
Institution "1" -- "0..*" Campaign : cria
Institution "1" -- "0..*" Post : publica
Institution "1" -- "0..*" DonationReport : gera

Donation "1" -- "1..*" DonationSplit : gera

Campaign "0..*" -- "0..*" Donation :direciona

Post "1" -- "0..*" PostAttachment : contém

@enduml
